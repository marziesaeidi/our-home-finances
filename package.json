{
  "name": "khaneh-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite preview --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "rates": "node server/rates.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/run.mjs && node --test tests/*.test.mjs",
    "database": "node server/sqlite.mjs",
    "database:init": "node --input-type=module -e \"import { openDatabase } from './server/database.mjs'; const db = openDatabase(); db.close(); console.log('SQLite ready: data/khaneh.sqlite');\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.7.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
