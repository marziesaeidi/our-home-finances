# Copy to .env and fill in real values. Never commit .env.

# SQLite database file (default: ./data/khaneh.sqlite)
DATABASE_PATH=./data/khaneh.sqlite

# Public HTTPS origin used when sharing (no trailing slash)
APP_PUBLIC_ORIGIN=https://your-subdomain.ngrok-free.dev

# Sharing access
SHARE_OWNER_EMAIL=owner@example.com
# Comma-separated list of extra guest emails
SHARE_GUEST_EMAIL=

# Exchange-rate proxy (Navasan)
NAVASAN_API_KEY=
NAVASAN_QUOTE_UNIT=
NAVASAN_UPDATE_DESCRIPTION=
FX_REFRESH_MINUTES=120
FX_PORT=8788

# Google Calendar connection (exposed to the browser by Vite)
VITE_GOOGLE_CLIENT_ID=
