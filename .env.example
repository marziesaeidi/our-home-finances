# Copy to .env and fill in real values. Never commit .env.

# Port the app server listens on (default 4173)
PORT=4173

# SQLite database file (default: ./data/khaneh.sqlite)
DATABASE_PATH=./data/khaneh.sqlite

# Public HTTPS origin of the deployed site, no trailing slash.
# Required in production: login cookies are marked Secure and requests from other origins are rejected.
APP_PUBLIC_ORIGIN=https://ourhome.example.com

# Set to 1 when running behind a reverse proxy (Traefik/Dokploy) so login rate limits use the real client IP
TRUST_PROXY=1

# Exchange-rate proxy (Navasan)
NAVASAN_API_KEY=
NAVASAN_QUOTE_UNIT=
NAVASAN_UPDATE_DESCRIPTION=
FX_REFRESH_MINUTES=120
FX_PORT=8788

# Google Calendar connection (exposed to the browser by Vite at build time)
VITE_GOOGLE_CLIENT_ID=
